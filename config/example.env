# Required external policy checkpoints
ADAPTER_CHECKPOINT=/path/to/VLA-Adapter-LIBERO-Long
OFT_CHECKPOINT=/path/to/openvla-7b-oft-finetuned-libero-10

# Separate Python environments
ADAPTER_PYTHON=/path/to/AsyncMixVLA/.venv-adapter/bin/python
OFT_PYTHON=/path/to/AsyncMixVLA/.venv-oft/bin/python

# Optional generated-output root
ASYNC_MIX_VLA_WORKDIR=/path/to/large/scratch/AsyncMixVLA
